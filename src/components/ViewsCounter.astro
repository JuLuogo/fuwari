---
import Icon from "@components/Icon.astro";
import { isViewCounterEnabled } from "../utils/view-counter";

type Props = {
	pathname: string;
	suffix?: string;
	id?: string;
};

const { pathname, suffix = "次" } = Astro.props;
const id =
	Astro.props.id ?? `page-views-${pathname.replace(/[^a-zA-Z0-9]+/g, "-")}`;
const enabled = isViewCounterEnabled();
---

{enabled && (
<div class="flex items-center" id={`${id}-wrapper`} style="display: none;">
	<div class="meta-icon">
		<Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
	</div>
	<span class="text-50 text-sm font-medium" id={id}></span>
</div>

<script is:inline define:vars={{ pathname, id, suffix }}>
	// 只登记「本页要显示浏览量的路径」，取数由 view-counter-runtime.ts 统一负责：
	// 优先 Umami 分享接口，失败或查不到时回落到自建接口（POST /batch）。
	window.__VIEWS_PATHS__ = window.__VIEWS_PATHS__ || [];
	if (!window.__VIEWS_PATHS__.some(function (item) { return item.id === id; })) {
		window.__VIEWS_PATHS__.push({ pathname: pathname, id: id, suffix: suffix });
	}
</script>
)}
