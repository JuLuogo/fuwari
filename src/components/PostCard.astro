---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Icon from "@components/Icon.astro";

import { randomImageConfig, umamiConfig } from "../config";
import { formatPostDateForDisplay } from "../utils/date-utils";
import { isEncrypted } from "../utils/post-visibility";
import { getDir } from "../utils/url-utils";
import PostMetadata from "./PostMeta.astro";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	loading?: "eager" | "lazy";
}
const {
	entry,
	title,
	url,
	published,
	updated,
	image,
	description,
	style,
	loading = "lazy",
} = Astro.props;

const isPinned = entry.data.pinned === true;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "28%";

// 加密文章：不显示 excerpt / 字数 / 阅读时长（都会泄露正文信息）
const encrypted = isEncrypted(entry);

const { remarkPluginFrontmatter } = await render(entry);
---
<a
    href={url}
    aria-label={title}
    class:list={["group card-base card-hover flex flex-col w-full relative py-6", className]}
    style={style}
>
    <div class:list={["pl-9 pr-2 relative", {"w-[calc(100%_-_52px_-_12px)]": !hasCover, "w-[calc(100%_-_var(--coverWidth)_-_12px)]": hasCover}]}>
        <h2
            class="transition w-full block font-bold mb-2 md:mb-3 text-xl md:text-3xl text-90 relative
        group-hover:text-[var(--primary)]
        group-active:text-[var(--title-active)]
        before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
        before:absolute before:top-1 md:before:top-2 before:-left-[1.125rem] before:block
        "
        >
            {title}
        </h2>

        <!-- description -->
        <div class:list={["transition text-75 mb-3.5 pr-4 line-clamp-1 md:line-clamp-2"]}>
            { encrypted ? "🔒 需要密码" : (description || remarkPluginFrontmatter.excerpt) }
        </div>

        <!-- metadata -->
        <PostMetadata
            published={published}
            updated={updated}
            hideUpdateDate={true}
            hidePublishedDate={false}
            slug={entry.id}
            showTime={false}
            class="mb-2 md:mb-4"
        ></PostMetadata>

        <!-- word count, read time and page views（加密文章不显示） -->
        {!encrypted && (
        <div class="text-sm text-white/30 flex gap-4 transition">
            <div>{remarkPluginFrontmatter.words} 字</div>
            <div>|</div>
            <div>{remarkPluginFrontmatter.minutes} 分钟</div>
        </div>
        )}

    </div>

    {hasCover && <div
                    class:list={[
                        "max-h-none mx-0 mt-0",
                        "w-[var(--coverWidth)] absolute top-0 bottom-0 right-3 overflow-hidden active:scale-95 flex items-center"
                    ]} >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
        <!-- 封面图上的箭头 -->
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full min-h-0" loading={loading} objectFit="contain">
        </ImageWrapper>
    </div>}

    {!hasCover &&
        <div class="!flex btn-regular w-[3.25rem]
         absolute right-3 top-0 bottom-0 bg-[var(--enter-btn-bg)]
         group-hover:bg-[var(--enter-btn-bg-hover)] group-active:bg-[var(--enter-btn-bg-active)] active:scale-95
        ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition text-[var(--primary)] text-4xl mx-auto">
            </Icon>
        </div>
    }
</a>



<style define:vars={{coverWidth}}>
</style>

<script define:vars={{ randomImage: randomImageConfig }}>
	(async function() {
		if (!randomImage || !randomImage.enable || !randomImage.baseUrl) return;
		const covers = document.querySelectorAll('.post-cover-random');
		if (!covers.length) return;
		const base = String(randomImage.baseUrl).replace(/\/+$/, "");
		let max = Number(randomImage.max) || 0;
		if (max <= 0) {
			// max 为 0 时自动从随机图 API 的 count.json 读取横屏图片数量
			try {
				const res = await fetch(`${base}/count.json`, { cache: "no-store" });
				if (res.ok) max = Number((await res.json())?.h) || 0;
			} catch {}
		}
		if (max <= 0) return;
		for (const img of covers) {
			const n = Math.floor(Math.random() * max) + 1;
			img.src = `${base}/ri/h/${n}.webp`;
		}
	})();

</script>
