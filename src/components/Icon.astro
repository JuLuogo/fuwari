---
import { iconSvg } from "@utils/icon-svg";

interface Props {
	name: string;
	class?: string;
	[key: string]: any;
}

const { name, class: className, ...rest } = Astro.props;

// 构建期就把图标解析成内联 SVG：运行时不会再向外请求图标数据
const svg = iconSvg(name);
---

<span class:list={["iconify-icon", className]} data-icon={name} {...rest}>
	{svg && <Fragment set:html={svg} />}
</span>

<style>
	.iconify-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1em;
		height: 1em;
		flex: none;
		vertical-align: -0.125em;
	}

	.iconify-icon :global(svg) {
		display: block;
		width: 1em;
		height: 1em;
	}
</style>
