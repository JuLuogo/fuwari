{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "random-pic",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-11",
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "juluo"
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://blog.juluo.work,https://juluo.work"
	},
	"routes": [
		{
			"pattern": "p.juluo.work",
			"custom_domain": true
		}
	]
}
